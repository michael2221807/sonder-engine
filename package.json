{
  "name": "sonder-engine",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke --reporter=list,html,github",
    "test:e2e:desktop": "playwright test --project=desktop-1920",
    "test:e2e:regression": "playwright test --grep @regression",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:all": "npm run typecheck && npm run typecheck:e2e && npm run test && npm run test:e2e:smoke",
    "lint": "eslint -c eslint-rules.mjs \"src/**/*.{ts,vue}\" \"e2e/**/*.ts\"",
    "knip": "knip --no-exit-code"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.2",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "cytoscape": "^3.33.2",
    "cytoscape-fcose": "^2.2.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "lodash-es": "^4.18.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4.6.4"
  }
}
