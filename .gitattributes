# Request-matrix snapshots are compared byte for byte (vitest toMatchFileSnapshot): keep them LF in every checkout,
# including Windows with core.autocrlf=true, or the matrix fails on a fresh checkout.
src/engine/pipeline/stages/__snapshots__/request-matrix/*.json text eol=lf
src/engine/ai/__snapshots__/reply-corpus/*.json text eol=lf
src/engine/image/__snapshots__/**/*.json text eol=lf
src/engine/pipeline/__snapshots__/path-contract/*.json text eol=lf
# R6 step 0 behaviour locks (backup round trip, GitHub request trace, memory writes): compared byte for byte.
src/engine/persistence/__snapshots__/**/*.json text eol=lf
src/engine/sync/__snapshots__/**/*.json text eol=lf
src/engine/memory/__snapshots__/**/*.json text eol=lf
src/engine/core/__snapshots__/**/*.json text eol=lf
src/bootstrap/__snapshots__/**/*.json text eol=lf
# R6 step 10: card import Stage 2 lock.
src/engine/export/__snapshots__/**/*.json text eol=lf
